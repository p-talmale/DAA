#include <stdio.h>

int n, target;
int arr[100];
int subset[100];
int solutions[1000][100];
int solutionSize[1000];
int count = 0;

void findSubsets(int index, int sum, int size) {
    // If target sum is reached
    if (sum == target) {
        for (int i = 0; i < size; i++) {
            solutions[count][i] = subset[i];
        }
        solutionSize[count] = size;
        count++;
        return;
    }

    // If all elements are checked
    if (index == n)
        return;

    // Include current element
    subset[size] = arr[index];
    findSubsets(index + 1, sum + arr[index], size + 1);

    // Exclude current element
    findSubsets(index + 1, sum, size);
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &target);

    findSubsets(0, 0, 0);

    if (count == 0) {
        printf("-1\n");
    } else {
        // Print in reverse order of discovery
        for (int i = count - 1; i >= 0; i--) {
            for (int j = 0; j < solutionSize[i]; j++) {
                printf("%d", solutions[i][j]);

                if (j < solutionSize[i] - 1)
                    printf(" ");
            }
            printf(" \n");
        }
    }

    return 0;
}
